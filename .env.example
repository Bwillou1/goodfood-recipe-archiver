# Copie ce fichier vers `.env` et remplis TES identifiants.
# Le fichier .env est dans le .gitignore : il ne sera JAMAIS committé sur GitHub.

# --- Identifiants Goodfood (connexion RÉELLE) ---
GOODFOOD_EMAIL=ton@email.com
GOODFOOD_PASSWORD=ton_mot_de_passe

# --- Réglages ---
# Chemin du fichier de session (cookies) Playwright
GOODFOOD_STORAGE_STATE=cookies/storage_state.json
# false = afficher le navigateur pendant le debug
GOODFOOD_HEADLESS=true
